rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Direct client writes are strictly disabled across the board.
    // All mutations must go through verified Next.js Server API endpoints
    // powered by the Firebase Admin SDK to guarantee authoritative anti-cheat RPG progression.
    
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;

      match /tasks/{taskId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // Deny all other unmatched documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
