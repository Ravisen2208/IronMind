# ==========================================
# IronMind Server Environment Configuration (Template)
# ==========================================

# Server Listening Port
PORT=5000

# Google Gemini API Key (Server Only - Free Tier)
# Get key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Admin SDK Configuration (Server Only)
# Generated from Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
FIREBASE_ADMIN_PROJECT_ID=your_firebase_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_firebase_project_id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Client Application URL (For CORS Whitelisting)
CLIENT_URL=http://localhost:3000
